{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis curated knowledge catalog or document",
  "$comment": "Runtime additionally enforces UTF-8/file/corpus byte limits, unique claim/source identities, source-reference resolution, valid dates and relative paths, and ordered source spans of at most 2001 lines. The schema is an editor/curation aid, never fetched by the server.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/document"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "catalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "files": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}\\.json$",
            "not": {
              "const": "catalog.json"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "title",
        "customer",
        "product",
        "processes",
        "summary",
        "lastReviewed",
        "orgVerification",
        "claims",
        "sources"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "customer": {
          "$ref": "#/$defs/slug"
        },
        "product": {
          "$ref": "#/$defs/slug"
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "pattern": "\\S"
        },
        "lastReviewed": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "orgVerification": {
          "const": "not-checked",
          "description": "This source snapshot is not a live-org parity or customer acceptance claim."
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "state",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "state": {
          "enum": [
            "implemented-local",
            "documented",
            "proposed",
            "unknown"
          ]
        },
        "sourceIds": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          },
          "else": {
            "properties": {
              "sourceIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "path",
        "sha256",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "repository": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Repository-relative citation metadata only. Runtime never opens this path. No absolute paths, colon, backslash, empty segments or dot segments."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Curator-reported SHA-256 of the entire cited source file; not verified by MCP at runtime."
        },
        "lines": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
