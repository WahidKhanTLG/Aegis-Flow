<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Return_Success</name><label>Return Verified Success</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varRecoverySucceeded</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
        <assignmentItems><assignToReference>varRecoveredRecordId</assignToReference><operator>Assign</operator><value><elementReference>varTargetRecordId</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varResultMessage</assignToReference><operator>Assign</operator><value><stringValue>Owned synthetic feedback has the verified recovery marker.</stringValue></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Return_Rejected</name><label>Return Rejected</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varRecoverySucceeded</assignToReference><operator>Assign</operator><value><booleanValue>false</booleanValue></value></assignmentItems>
        <assignmentItems><assignToReference>varResultMessage</assignToReference><operator>Assign</operator><value><stringValue>Only an owned, explicitly marked QA feedback record may be recovered.</stringValue></value></assignmentItems>
    </assignments>
    <decisions>
        <name>Require_QA_Capability</name><label>Require QA Capability</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Return_Rejected</targetReference></defaultConnector><defaultConnectorLabel>Denied</defaultConnectorLabel>
        <rules><name>Has_QA_Capability</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>$Permission.AEIR_QA_Flow_Retry</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
            <connector><targetReference>Get_Owned_Target</targetReference></connector><label>Explicit QA Entitlement</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QA_Marker</name><label>Check QA Marker</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Return_Rejected</targetReference></defaultConnector><defaultConnectorLabel>Not An Approved QA Record</defaultConnectorLabel>
        <rules><name>Already_Recovered</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Owned_Target.Comments__c</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>fxRecoveredMarker</elementReference></rightValue></conditions>
            <connector><targetReference>Return_Success</targetReference></connector><label>Idempotent Existing Result</label>
        </rules>
        <rules><name>Pending_Recovery</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Owned_Target.Comments__c</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>fxPendingMarker</elementReference></rightValue></conditions>
            <connector><targetReference>Write_Recovery_Marker</targetReference></connector><label>Approved Synthetic Pending Record</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Recovery_Marker</name><label>Verify Actual Recovery Write</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Return_Rejected</targetReference></defaultConnector><defaultConnectorLabel>Postcondition Failed</defaultConnectorLabel>
        <rules><name>Verified_Recovered</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Verified_Target.Comments__c</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>fxRecoveredMarker</elementReference></rightValue></conditions>
            <connector><targetReference>Return_Success</targetReference></connector><label>Stored Postcondition Verified</label>
        </rules>
    </decisions>
    <description>QA ONLY. Synchronously changes one owned Error Feedback record from an exact synthetic pending marker to its corresponding recovered marker. Enforces explicit QA permission and verifies the stored result. No customer tax/order logic, remote calls, emails, waits or immediate events.</description>
    <environments>Default</environments>
    <formulas><name>fxPendingMarker</name><dataType>String</dataType><expression>&quot;AEIR-QA-RECOVERY:PENDING:&quot; &amp; {!varRecoveryKey}</expression></formulas>
    <formulas><name>fxRecoveredMarker</name><dataType>String</dataType><expression>&quot;AEIR-QA-RECOVERY:DONE:&quot; &amp; {!varRecoveryKey}</expression></formulas>
    <interviewLabel>Aegis QA Approved Recovery {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Aegis QA Approved Recovery</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Owned_Target</name><label>Get Owned QA Target</label><locationX>0</locationX><locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_QA_Marker</targetReference></connector>
        <faultConnector><targetReference>Return_Rejected</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varTargetRecordId</elementReference></value></filters>
        <filters><field>OwnerId</field><operator>EqualTo</operator><value><elementReference>$User.Id</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly><object>Error_Feedback__c</object><storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Verified_Target</name><label>Read Stored QA Result</label><locationX>0</locationX><locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Verify_Recovery_Marker</targetReference></connector>
        <faultConnector><targetReference>Return_Rejected</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varTargetRecordId</elementReference></value></filters>
        <filters><field>OwnerId</field><operator>EqualTo</operator><value><elementReference>$User.Id</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly><object>Error_Feedback__c</object><storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Write_Recovery_Marker</name><label>Write Owned Synthetic Recovery Marker</label><locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Get_Verified_Target</targetReference></connector>
        <faultConnector><targetReference>Return_Rejected</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varTargetRecordId</elementReference></value></filters>
        <filters><field>OwnerId</field><operator>EqualTo</operator><value><elementReference>$User.Id</elementReference></value></filters>
        <inputAssignments><field>Comments__c</field><value><elementReference>fxRecoveredMarker</elementReference></value></inputAssignments>
        <object>Error_Feedback__c</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Require_QA_Capability</targetReference></connector></start>
    <status>Active</status>
    <variables><name>varTargetRecordId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>varCorrelationId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>varAttemptNumber</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><scale>0</scale></variables>
    <variables><name>varRecoveryKey</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>varRecoverySucceeded</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><value><booleanValue>false</booleanValue></value></variables>
    <variables><name>varRecoveredRecordId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
    <variables><name>varResultMessage</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
