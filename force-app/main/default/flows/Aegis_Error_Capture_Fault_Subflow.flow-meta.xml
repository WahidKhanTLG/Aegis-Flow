<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Reuse the caller supplied correlation id when present, otherwise derive one from the Flow interview so the id is unique per failed run.</description>
        <name>Resolve_Correlation_Id</name>
        <label>Resolve Correlation Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCorrelationId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxCorrelationId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Publish_Error_Captured_Event</targetReference>
        </connector>
    </assignments>
    <description>Reusable Aegis Flow fault subflow. Connect customer Flow fault paths here. Publishes Error_Captured__e so the failure is preserved even when the calling transaction rolls back, and returns the correlation id for a friendly user-facing reference.</description>
    <environments>Default</environments>
    <formulas>
        <description>Prefer the business user supplied by the caller. Background Flows run as Automated Process, so falling back to $User.Id alone would misattribute the failure.</description>
        <name>fxAffectedUserId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varInitiatingUserId}), CASESAFEID({!$User.Id}), {!varInitiatingUserId})</expression>
    </formulas>
    <formulas>
        <description>Caller supplied id wins so a multi-step process keeps one id across all of its failures.</description>
        <name>fxCorrelationId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varCorrelationId}), &quot;FLOW-&quot; &amp; {!$Flow.InterviewGuid}, {!varCorrelationId})</expression>
    </formulas>
    <formulas>
        <description>Flow api name plus the failing element, so triage does not require opening the Flow.</description>
        <name>fxSourceName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varFlowApiName}), &quot;Unknown Flow&quot;, {!varFlowApiName})
&amp; IF(ISBLANK({!varFailedElementApiName}), &quot;&quot;, &quot; / &quot; &amp; {!varFailedElementApiName})</expression>
    </formulas>
    <interviewLabel>Aegis Error Capture Fault Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Aegis Error Capture Fault Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Publishing the platform event rather than writing Error_Log__c directly keeps the evidence even if the calling transaction rolls back.</description>
        <name>Publish_Error_Captured_Event</name>
        <label>Publish Error Captured Event</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Context_JSON__c</field>
            <value>
                <elementReference>varContextJson</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Correlation_Id__c</field>
            <value>
                <elementReference>varCorrelationId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>varFaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Object_API_Name__c</field>
            <value>
                <elementReference>varObjectApiName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Record_Id__c</field>
            <value>
                <elementReference>varRecordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_Name__c</field>
            <value>
                <elementReference>fxSourceName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>User_Id__c</field>
            <value>
                <elementReference>fxAffectedUserId</elementReference>
            </value>
        </inputAssignments>
        <object>Error_Captured__e</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Resolve_Correlation_Id</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varContextJson</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCorrelationId</name>
        <dataType>String</dataType>
