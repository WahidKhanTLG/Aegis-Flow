<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Diagnosis_Duration_Minutes__c</fullName>
    <description>Duration from capture to a server-stamped transition; unknown historic times remain empty.</description>
    <formula>IF(OR(ISBLANK(First_Diagnosed_At__c), First_Diagnosed_At__c &lt; CreatedDate), NULL, (First_Diagnosed_At__c - CreatedDate) * 1440)</formula>
    <label>Minutes to First Diagnosis</label>
    <precision>18</precision>
    <scale>4</scale>
    <type>Number</type>
</CustomField>
